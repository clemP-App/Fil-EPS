# URL publique du site, utilisée pour les liens absolus du flux RSS, du sitemap et d'Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret long et aléatoire qui signe le cookie d'administration. Ne jamais le préfixer par NEXT_PUBLIC_.
ADMIN_SECRET=

# Mot de passe saisi sur /admin/login. Il reste côté serveur.
ADMIN_PASSWORD=

# Connexion PostgreSQL (Supabase). Sans cette variable, l'application utilise le fichier SQLite data/veille.db.
# DATABASE_URL=postgresql://postgres.[projet]:[mot-de-passe]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DATABASE_SSL=require

# Dossier du fichier SQLite lorsque DATABASE_URL est absent.
# DATA_DIR=./data
